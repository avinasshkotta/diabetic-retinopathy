# --- data (8 GB, linked via data/raw junction, never committed) ---
data/raw/
data/raw/**
*.png
*.jpg

# --- trained weights (16 MB each; artifact storage comes in Step 2) ---
models/*.pt
# Deployment checkpoints are committed so a clean checkout can build the image
# (Dockerfile.cpu does COPY models/ and the service loads these three seeds).
!models/dr_efficientnetb0_seed42.pt
!models/dr_efficientnetb0_seed123.pt
!models/dr_efficientnetb0_seed777.pt

# --- generated (regenerable) ---
# NOTE: data/gold/splits is deliberately NOT ignored — the frozen split
# manifests are committed so the test-set guarantee survives machine changes.
reports/

# --- mlflow (server data; regenerated, never committed) ---
mlflow.db
mlartifacts/
mlruns/

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# --- editors / os ---
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- deploy secrets/artifacts (never commit) ---
*.pem
dr-api-cpu.tar

data/gold/predictions.csv   # runtime prediction log, not source
